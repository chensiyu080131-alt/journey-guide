<view class="page">
  <view class="hero">
    <view class="hero-title">寻迹</view>
    <view class="hero-sub">选一首诗，走一条文学路线</view>
  </view>

  <view class="search">
    <input class="search-input" placeholder="搜诗名 / 作者 / 城市" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
  </view>

  <view class="list">
    <view class="card" wx:for="{{routes}}" wx:key="id" bindtap="goRoute" data-id="{{item.id}}">
      <view class="card-top">
        <text class="card-title">{{item.title}}</text>
        <text class="card-badge">{{item.unlocked}}/{{item.spotCount}} 已打卡</text>
      </view>
      <view class="card-poem">《{{item.poemTitle}}》 {{item.author}}</view>
      <view class="card-meta">🚶 {{item.distance}}km · ⏱ {{item.duration}}分钟 · {{item.spotCount}}个景点</view>
    </view>

    <view wx:if="{{routes.length === 0}}" class="empty">没有匹配的路线，换个关键词试试</view>
  </view>
</view>

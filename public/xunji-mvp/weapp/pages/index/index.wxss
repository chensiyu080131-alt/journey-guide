.hero {
  background: linear-gradient(135deg, #7c2d12, #b45309);
  color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 48rpx; font-weight: 700; letter-spacing: 8rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }

.search { margin-bottom: 24rpx; }
.search-input {
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-top { display: flex; justify-content: space-between; align-items: center; }
.card-title { font-size: 32rpx; font-weight: 600; }
.card-badge {
  font-size: 22rpx; color: #7c2d12;
  background: #fde9d7; border-radius: 999rpx; padding: 4rpx 16rpx;
}
.card-poem { font-size: 26rpx; color: #6b5b4d; margin-top: 12rpx; }
.card-meta { font-size: 24rpx; color: #9ca3af; margin-top: 12rpx; }

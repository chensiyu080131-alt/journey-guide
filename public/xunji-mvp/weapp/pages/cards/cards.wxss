.head { font-size: 36rpx; font-weight: 700; padding: 16rpx 8rpx; }
.progress { font-size: 26rpx; color: #7c2d12; font-weight: 600; margin-bottom: 24rpx; }

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.card {
  background: linear-gradient(135deg, #fffbeb, #fde9d7);
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.card-city { font-size: 22rpx; color: #9ca3af; }
.card-name { font-size: 32rpx; font-weight: 700; color: #7c2d12; margin: 6rpx 0; }
.card-ori { font-size: 24rpx; color: #4b3b2e; }
.card-route { font-size: 22rpx; color: #b45309; margin-top: 10rpx; }

.btn-share {
  margin: 32rpx auto 0;
  width: fit-content;
  background: #7c2d12;
  color: #fff;
  font-size: 28rpx;
  padding: 18rpx 48rpx;
  border-radius: 40rpx;
  text-align: center;
}
/* 离屏隐藏：仅用于绘制海报，不参与页面布局 */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 420px;
}

.head { font-size: 36rpx; font-weight: 700; color: #7c2d12; display: flex; align-items: center; }
.tag { font-size: 20rpx; background: #7c2d12; color: #fff; padding: 2rpx 12rpx; border-radius: 16rpx; margin-left: 16rpx; }
.note { font-size: 22rpx; color: #9ca3af; margin: 12rpx 0 24rpx; }
.stat-row { display: flex; justify-content: space-between; gap: 12rpx; }
.stat { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx 8rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.stat-num { font-size: 40rpx; font-weight: 700; color: #7c2d12; }
.stat-label { font-size: 20rpx; color: #6b7280; margin-top: 6rpx; }
.block { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-top: 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.block-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #2b2118; }
.heat-item { display: flex; align-items: center; padding: 10rpx 0; }
.heat-rank { width: 40rpx; color: #b45309; font-weight: 700; }
.heat-name { width: 200rpx; font-size: 26rpx; }
.heat-city { font-size: 20rpx; color: #9ca3af; margin-left: 8rpx; }
.heat-bar-wrap { flex: 1; background: #f1ece4; border-radius: 8rpx; height: 20rpx; overflow: hidden; }
.heat-bar { height: 100%; background: linear-gradient(90deg,#d97706,#7c2d12); }
.heat-count { width: 90rpx; text-align: right; font-size: 24rpx; color: #7c2d12; }
.heat-tip { font-size: 20rpx; color: #9ca3af; margin-top: 10rpx; }
.bar-item { display: flex; align-items: center; padding: 8rpx 0; }
.bar-label { width: 110rpx; font-size: 24rpx; }
.bar-wrap { flex: 1; background: #f1ece4; border-radius: 8rpx; height: 20rpx; overflow: hidden; }
.bar { height: 100%; background: #7c2d12; }
.bar-age { background: #0f766e; }
.bar-pct { width: 80rpx; text-align: right; font-size: 22rpx; color: #6b7280; }
